# BEMS .gitignore

# Sensitive Configuration
.env
.env.local
.env.production
.env.backup

# Database config is no longer sensitive (uses env vars)
# config/database.php - removed from gitignore

# Temporary Files
cookies.txt
*.tmp
*.log

# Playwright Test Results
.playwright-mcp/
test-results/
playwright-report/

# PHP Dependencies
vendor/
composer.lock

# Development Files
*.swp
*.swo
*~

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE Files
.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project

# Test Files (temporary)
test_*.php
demo.php
simple-*.php

# Cache and Session Files
cache/
sessions/
logs/

# Backup Files
*.bak
*.backup